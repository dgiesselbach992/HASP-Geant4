# Macro file for example B1
# 
# To be run preferably in batch, without graphics:
# % exampleB1 run2.mac
#
/run/numberOfThreads 4
#
/random/setSeeds SEED1 SEED2 SEED3 SEED4
#
/control/verbose 2
/run/verbose 2
#
/run/initialize
#
# /run/printProgress 1
# /run/beamOn 5000
#
/gun/energy ENERGY_VALUE
#
/run/printProgress 5000
/run/beamOn PARTICLES

