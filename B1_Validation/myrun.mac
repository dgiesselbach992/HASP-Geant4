# Macro file for example B1
# 
# To be run preferably in batch, without graphics:
# % exampleB1 run2.mac
#
/run/numberOfThreads 2
#
/random/setSeeds SEED1 SEED2
#
/control/verbose 2
/run/verbose 2
#
/run/initialize
#
# /run/printProgress 1
# /run/beamOn 10
#
/gun/energy ENERGY_VALUE
#
# /run/printProgress 100
/run/beamOn PARTICLES

